{
  "name": "mcm-app",
  "projectType": "application",
  "root": "frontend/mcm-app",
  "sourceRoot": "frontend/mcm-app/src",
  "tags": [
    "scope:frontend",
    "type:app",
    "platform:mobile",
    "platform:web"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --watchAll=false",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config jest.integration.config.js --watchAll=false",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --ext .ts,.tsx",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "e2e:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/maestro-e2e.mjs",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "e2e:agents": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/agent-e2e.mjs",
        "cwd": "{workspaceRoot}"
      },
      "cache": false,
      "metadata": {
        "description": "Run the feature-012 agent E2E specs (assistant-*.spec.ts, E2E_AGENT_PRODUCTION=1) against the containerized production-node agent stack, isolated per spec. Requires `nx up-agents-prod infrastructure-as-code` first. Pass --args=assistant-add for a single spec."
      }
    },
    "e2e:mobile:session-timeout": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/maestro-session-timeout.mjs",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --build-arg EXPO_PUBLIC_KEYCLOAK_URL -t mcm-bff:latest -f frontend/mcm-app/Dockerfile .",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "start-keycloak": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f infrastructure-as-code/docker/keycloak/compose.yaml up -d",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f infrastructure-as-code/docker/bff/compose.yaml --profile bff-nonsecure --profile bff-secure up -d",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [
        "build",
        "start-keycloak"
      ],
      "cache": false
    },
    "eas-build-local": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eas build --local --platform android --profile development",
        "cwd": "{projectRoot}"
      }
    },
    "build-apk": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-apk.mjs",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "export-server": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"require('fs').rmSync('node_modules/.cache/tamagui',{recursive:true,force:true})\" && npx expo export --platform web --source-maps --clear",
        "cwd": "{projectRoot}"
      },
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "metadata": {
        "description": "Production web export (the BFF bundle). Cold on every run, deliberately (feature 081 US10): @tamagui/metro-plugin does not invalidate Metro's transform cache when the Tamagui config or the design system's tokens/themes change but app sources do not, so a warm export can serve stale compiled styles. The target therefore clears the app-local Tamagui compiler cache and passes --clear. inputs are explicit: this project (tamagui.config.ts, metro.config.js, babel.config.js) plus ^default, i.e. every design-system source, so the nx cache misses on exactly those changes."
      }
    },
    "bundle-budget": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-web-bundle-budget.mjs --dist frontend/mcm-app/dist --require-maps",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [
        "export-server"
      ],
      "cache": true
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --build-arg EXPO_PUBLIC_KEYCLOAK_URL -t mcm-bff:latest -f frontend/mcm-app/Dockerfile .",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f infrastructure-as-code/docker/bff/compose.yaml --profile bff-nonsecure --profile bff-secure up -d",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f infrastructure-as-code/docker/bff/compose.yaml down",
        "cwd": "{workspaceRoot}"
      }
    },
    "test:load": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tests/load/run.js",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
