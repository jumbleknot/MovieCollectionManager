{
  "name": "mcm-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:integration": "jest --testPathPattern=tests/integration --watchAll=false",
    "test:e2e:mobile": "maestro test tests/e2e/mobile/",
    "test:e2e:web": "npx nx e2e",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ai-sdk/openai": "^3.0.68",
    "@copilotkit/react-native": "1.70.1",
    "@copilotkit/runtime": "1.70.1",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo-google-fonts/outfit": "^0.4.0",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/server": "~0.5.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@mcm/design-system": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-picker/picker": "^2.11.4",
    "@tamagui/core": "3.0.18",
    "@tamagui/stacks": "3.0.18",
    "axios": "^1.7.9",
    "expo": "~57.0.30",
    "expo-auth-session": "~57.0.16",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.11.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongodb": "^7.3.0",
    "openai": "^6.42.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-streamdown": "^0.2.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.7.5",
    "@types/react": "~19.2.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~57.0.16",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/../../packages/design-system/jest/tamagui-cjs-resolver.js",
    "verbose": false,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?|@expo-google-fonts|react-navigation|@react-navigation|@unimodules|unimodules|sentry-expo|native-base|react-native-svg|@copilotkit|@ag-ui|uuid|tamagui|@tamagui|standard-navigation)[^/]*/node_modules)",
      "node_modules/(?!(\\.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?|@expo-google-fonts|react-navigation|@react-navigation|@unimodules|unimodules|sentry-expo|native-base|react-native-svg|@copilotkit|@ag-ui|uuid|tamagui|@tamagui|standard-navigation))",
      "/node_modules/react-native/Libraries/Renderer/implementations/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/",
      "/tests/load/",
      "/tests/web-e2e/",
      "/tests/integration/"
    ],
    "moduleNameMapper": {
      "^expo-router/server$": "<rootDir>/__mocks__/expo-router-server.js",
      "^@react-native-picker/picker$": "<rootDir>/__mocks__/@react-native-picker/picker.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__mocks__/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  },
  "overrides": {
    "react-dom": "19.2.3",
    "postcss": ">=8.5.10"
  },
  "private": true
}
