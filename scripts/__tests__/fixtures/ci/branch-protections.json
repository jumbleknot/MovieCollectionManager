[
  {
    "rule_name": "main",
    "branch_name": "main",
    "enable_status_check": true,
    "status_check_contexts": [
      "guardrails*",
      "app-ci / changes*",
      "app-ci / affected*",
      "app-ci / mc-service-checks*",
      "app-ci / app-e2e*",
      "infra-image-scan / infra-image-scan*"
    ]
  },
  {
    "rule_name": "release/*",
    "branch_name": "",
    "enable_status_check": true,
    "status_check_contexts": ["guardrails*"]
  },
  {
    "rule_name": "legacy-no-checks",
    "branch_name": "legacy-no-checks",
    "enable_status_check": false,
    "status_check_contexts": ["guardrails*"]
  }
]
