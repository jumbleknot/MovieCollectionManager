# agents/movie-assistant/.env.local — TEMPLATE (item #463)
#
# Copy to `.env.local` in this directory and fill in what you need. `.env.local` is gitignored;
# THIS file is tracked, so it must never carry a real value — every secret below is left EMPTY on
# purpose, with the shape described in the comment above it.
#
# Why this file is copied by hand rather than generated. `scripts/gen-dev-env.mjs` writes every
# other `.env.local` in the repository and deliberately skips this one: it carries the operator's
# own Anthropic credential, which CLAUDE.md scopes to MCM_ANTHROPIC_API_KEY and maps to
# ANTHROPIC_API_KEY only at the point of use. A generator that minted or projected that key would
# become a fourth place it lives. The generator NAMES this file in its output so the skip is
# visible rather than silent (item #227); `scripts/__tests__/gen-dev-env.guard.test.mjs` pins both
# halves of that claim.
#
# EVERYTHING HERE IS OPTIONAL. The gateway starts with none of it set: the model provider defaults
# to Ollama, and every observability/audit/policy integration is env-gated and no-ops when unset
# (SC-005, additive). The defaults shown are the ones in the source, not aspirations.
#
# Reference: docs/runbooks/agent-layer.md, and "Models" / "Observability" in ./README.md.

# ── Model provider ───────────────────────────────────────────────────────────────────────────────
# `ollama` (default) or `anthropic`. Dev and test run on Ollama; the golden test surface and prod
# run on Claude — openwiki/invariants/model-provider-scoping.md explains why this is env-scoped
# rather than one global choice.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Per-node model ids. Unset = the provider's default for that tier:
#   supervisor  ollama qwen2.5       | anthropic claude-haiku-4-5
#   specialist  ollama qwen2.5:32b   | anthropic claude-sonnet-4-6   (curator/organizer/query)
#   escalation  claude-opus-4-8 ALWAYS — the frontier escape hatch ignores MODEL_PROVIDER
SUPERVISOR_MODEL=
SPECIALIST_MODEL=
ESCALATION_MODEL=

# The operator's own Anthropic key — `sk-ant-…`. Required by MODEL_PROVIDER=anthropic, by the
# escalation node whatever the provider, and by `LLM_CASSETTE_MODE=record`. Leave EMPTY unless you
# are running one of those. Do NOT export ANTHROPIC_API_KEY into your shell: Claude Code silently
# prefers it over a subscription login and bills per token (see CLAUDE.md).
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_RETRIES=6

# Golden-test cassettes: unset = replay recorded turns; `record` = call the live model.
LLM_CASSETTE_MODE=

# ── MCP tool servers ─────────────────────────────────────────────────────────────────────────────
# Unset = that tool group is not registered. The values below are the in-network Compose names;
# use http://localhost:<port>/mcp when running the servers on the host instead.
MOVIE_MCP_URL=http://movie-assistant-mcp-movie:8000/mcp
WEB_API_MCP_URL=http://movie-assistant-mcp-webapi:8000/mcp
SPREADSHEET_MCP_URL=http://movie-assistant-mcp-spreadsheet:8000/mcp

# ── Identity (Keycloak token exchange) ───────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8099
KEYCLOAK_REALM=grumpyrobot
AGENT_GATEWAY_CLIENT_ID=agent-gateway
# The gateway's OAuth client secret. In production this comes from the Komodo Variable / Vault,
# never from a file — see ADR-0001 and openwiki/invariants/secrets-management.md. For local work,
# `node scripts/gen-dev-secrets.mjs` mints the realm's dev value into
# infrastructure-as-code/docker/stacks/auth.env; copy it here only if you run the gateway outside
# Compose.
AGENT_GATEWAY_CLIENT_SECRET=

# ── Observability — all env-gated, all no-op when unset (`--profile observability`) ──────────────
# LangFuse per-turn cost/latency. Both keys must be set for tracing to activate.
LANGFUSE_HOST=http://localhost:3030
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenTelemetry → the otel-lgtm stack (Tempo/Prometheus/Loki/Grafana).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=movie-assistant-gateway

# Vault (dev mode) — shared infra secrets only; both must be set to activate.
VAULT_ADDR=
VAULT_TOKEN=

# OPA agent authz (token-exchange + ui-action policies). Unset = fall back to the TS authorizer.
OPA_URL=

# Unleash feature flags — mcm.agent.{kill-switch,frontier-escalation,degrade}, all default-off.
# Unset = fall back to the env flags below. UNLEASH_CACHE_DIR must be writable by the non-root
# app user; unset = a temp dir (feature 034 — the default ~/.cache path crashed prod on 2026-07-08).
UNLEASH_URL=
UNLEASH_API_TOKEN=
UNLEASH_CACHE_DIR=

# ── Audit sink (`--profile audit`) ───────────────────────────────────────────────────────────────
# Unset = agent audit events are logged only, never written to OpenSearch.
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ── Guardrails and budgets ───────────────────────────────────────────────────────────────────────
# Kill switch — any of 1/true/yes/on/disabled halts the agent. Default off.
AGENT_KILL_SWITCH=

# Per-turn budgets. Unset = no budget enforced.
AGENT_PER_TURN_COST_BUDGET_USD=
AGENT_TURN_LATENCY_BUDGET_MS=

# Error-rate circuit breaker (defaults shown).
AGENT_ERROR_RATE_THRESHOLD=0.5
AGENT_ERROR_RATE_WINDOW=20
AGENT_ERROR_RATE_MIN_SAMPLES=5
AGENT_ERROR_RATE_COOLDOWN_S=30

# Per-turn tool-call rate limit (defaults shown).
AGENT_TOOL_CALL_LIMIT=30
AGENT_TOOL_CALL_WINDOW_SECONDS=60

# ── Misc ─────────────────────────────────────────────────────────────────────────────────────────
AGENT_LOG_LEVEL=INFO
# Parallel applies when an approved spreadsheet import is committed.
IMPORT_APPLY_CONCURRENCY=8
