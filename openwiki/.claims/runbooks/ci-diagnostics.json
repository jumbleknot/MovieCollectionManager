    {
      "id": "claim_1e9d793eb64b46d8a67164443668c798",
      "statement": "ci-log-step.sh records one row per wrapped CI step into a per-run duration sample (step, seconds, exit code, ceiling) on every run, success or failure, and scripts/ci-step-ceilings.tsv is generated from that sample by `ci-status.mjs durations --propose` using the rule max(observed) x 3 (rounded up to a minute, floored at 300s); a step killed at its ceiling is recorded as censored and excluded from the sample specifically to prevent an anti-ratchet failure where each kill would shrink the next calibration's observed maximum and tighten the ceiling until legitimate runs start failing.",
      "evidence": [
        {
          "resource": "repo://scripts/ci-log-step.sh#L1-L40",
          "version": "repo-lines-v1:sha256:c5e6a1d0559ecbbb54ceebc2a565902524f12f41b5fca18c6495a0959299c669:"
