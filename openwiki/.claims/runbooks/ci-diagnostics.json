  "claims": [
    {
      "id": "claim_6c612ef238414a1a80f18ea6956fc1c9",
      "statement": "scripts/ci-status.mjs derives two check states that the raw Forgejo API misreports rather than trusting the literal payload: a path-gated job reads status=success with description \"Has been skipped\" (fails safe, since the payload never states why), and a run cancelled by a newer push reads status=failure on every context it touched even though nothing broke (fails loud, announcing a broken build that isn't); classifyCheckState checks the cancelled description or the owning run's own cancelled status before the success/failure branches to catch this.",
      "evidence": [
        {
          "resource": "repo://scripts/ci-status.mjs#L193-L283",
          "version": "repo-lines-v1:sha256:178a2a2576bc4b894a600b5f98c06a2d0e85968886a426a21fa8d414cb349c88:"
        }
      ]
    },
    {
      "id": "claim_c3efe049ea6341a29f82b44d3a7a09b4",
      "statement": "ci-status.mjs prints one of three skip-cause annotations derived by walking `needs:` edges parsed out of .forgejo/workflows/*.yml, because the commit-status payload for a skipped job never states why it was skipped: '(path-gated -> satisfied)' when every needs: dependency passed, '(NOT run - needs: X, which did not pass)' when a declared dependency failed, and '(skipped - cause not determined: ...)' when the workflow can't be parsed or the dependency hasn't reported yet.",
      "evidence": [
        {
          "resource": "repo://scripts/ci-status.mjs#L285-L299",
          "version": "repo-lines-v1:sha256:8a611b1a99871920db10a30536310fd86819a95d23f71fb23b7582039048224d:"
