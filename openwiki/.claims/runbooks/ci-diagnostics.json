    {
      "id": "claim_c5c4a60323aa490a8b5c2cdc57a7b143",
      "statement": "Because only app-e2e publishes a counts bundle on an explicit green run, every other CI job's successful run leaves no machine-readable trace of what its steps measured (no bundle, no per-job log endpoint, no commit status by default); the pattern used to recover a measurement from an otherwise-silent green job is to have the step export its value to $GITHUB_OUTPUT and add an always()-gated, continue-on-error step that curls the value onto the commit as its own commit status (state always 'success', with the finding carried in the description, and the context name checked against the live required-check glob list so it cannot accidentally start gating merges).",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/app-ci.yml#L1-L60",
          "version": "repo-lines-v1:sha256:ca4acaa37cd9133aedda82590f637d33e17695a1e60c17bdc32ee4fb94f492fe:"
        }
