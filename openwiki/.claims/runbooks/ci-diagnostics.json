    {
      "id": "claim_7595c235ca8147a6818a473e2456bc45",
      "statement": "ci-status.mjs classifies a commit-status context's event from Forgejo's `event` field (push/pull_request/etc, embedded as a suffix like `guardrails / secret-scan (push)`), while a scheduled (cron) run reports `event: push` even though the run's `trigger_event` field is `schedule`; a step gated `if: github.event_name == 'schedule'` follows trigger_event and does run on the cron, so reading the `event` field alone to decide whether a scheduled check ever executed produces a false conclusion that it never ran.",
      "evidence": [
        {
          "resource": "repo://scripts/__tests__/renovate-health.test.mjs#L219-L256",
          "version": "repo-lines-v1:sha256:ac8623b8bfe9de124c1ee053c6bec4110b0470b0b225c7819d8b9fc8349215b3:"
