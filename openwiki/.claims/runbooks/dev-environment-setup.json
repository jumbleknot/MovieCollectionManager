    {
      "id": "claim_8f7a79e3fd494f0ab00151d442c0c9dd",
      "statement": "The pnpm version is single-sourced by the root package.json packageManager field and must be declared nowhere else: any other site naming a pnpm version (a workflow pnpm/action-setup version, a Dockerfile corepack prepare pnpm@X) must name the same one, and findNestedPackageManagerDrift fails any non-root package.json that declares the field at all — including one whose value agrees — because corepack and pnpm resolve packageManager from the nearest manifest above the cwd and Renovate maintains a duplicate as a separate dependency on its own track.",
      "evidence": [
        {
          "resource": "repo://package.json#L5-L5",
          "version": "repo-lines-v1:sha256:4513883908ffddc56e384929eadc7cbb3520af5efea1b15b39265b92fa404f7a:"
        },
        {
