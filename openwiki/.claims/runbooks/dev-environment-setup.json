    {
      "id": "claim_6a3f9fd9c0b740e397338a7b2b822d1b",
      "statement": "The pinned OpenWiki generator raises its own Node requirement above this repository's floor: OpenWiki requires Node >= 22.22, so a host that satisfies the repo's >=22.13 engines.node floor but sits below 22.22 cannot run the generator even though every other toolchain check passes.",
