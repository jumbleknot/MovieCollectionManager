    {
      "id": "claim_cbe19d1e79c34a68b552b7eef3577361",
      "statement": "The two former bind-prefix variables are retired: `KC_ADMIN_BIND_IP` (dropped from the keycloak compose bind in feature 028, and stopped being passed to `prod-auth` on 2026-10-12) and `TS_ADMIN_IP` (stopped being passed to `prod-observability` on 2026-10-13) are read by no stack or compose file, so the stack `environment` line and the Komodo Variable should be retired together — a still-seeded leftover cannot fail a deploy, it is only dead config.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/prod-reboot-resilience.md#L96-L98",
          "version": "repo-lines-v1:sha256:2883c24f9b05328907dcfbd0d13dd6fcf6c95150bd9f640ab1ff3b8cef3f505e:"
