        }
      ]
    },
    {
      "id": "claim_63b519559438470f8c11dfc79c0f70f2",
      "statement": "The graceful-shutdown drain unit was reworked to stop containers in parallel: run sequentially as `docker stop -t 30 $(docker ps -q)` it exceeded `TimeoutStopSec=120` with roughly 40 containers and was SIGKILL'd mid-drain, stopping a non-deterministic subset.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/prod-reboot-resilience.md#L185-L191",
          "version": "repo-lines-v1:sha256:58db9343dafe8fcae8a0166caa7bca24c05bf0c4228146511b5ac159660f0337:"
        }
