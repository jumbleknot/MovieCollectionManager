    {
      "id": "claim_4a765991cadf406395dfa969072f00ca",
      "statement": "The collision gate only reads a compose file's `ports:` key, so moving a published port is not finished when the bind changes: the same number usually reappears as a self-referencing URL that must move in lockstep — today Keycloak's `KC_HOSTNAME_ADMIN` and LangFuse's `NEXTAUTH_URL` — and a bookmark on the previous admin port is stale.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/docker/observability/compose.prod.yaml#L70-L74",
          "version": "repo-lines-v1:sha256:8ff8a01b6b0f3f34ecfd2ab6a02b8dc44ca9434bad309004fc7e434ce3fbeb25:"
