          "version": "repo-lines-v1:sha256:4aeafb227da2885197e08ab3db1ab703561a14cdbbe8b77e05eec786e6a65c05:"
        }
      ]
    },
    {
      "id": "claim_01d74274dce740c283310625c31ff968",
      "statement": "The three production admin/UI publishes (Keycloak admin `19099`, LangFuse web `19030`, Grafana/otel-lgtm `19002`) all bind `0.0.0.0` on ports in the prod-reserved range `19000–19099`, which is disjoint from every CI/dev-published port because prod and the CI runner are two rootless daemons publishing into the same host port space; the invariant is owned by the published-port reservation page.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/docker/keycloak/compose.prod.yaml#L46-L53",
          "version": "repo-lines-v1:sha256:1ef62a7f882189f1e1c90b06caa08c379b11f28be45b2579e3d56f5cd8d70b9b:"
