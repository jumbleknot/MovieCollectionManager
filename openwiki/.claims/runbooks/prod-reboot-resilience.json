        }
      ]
    },
    {
      "id": "claim_48c4e4833ab94346b5dff8befe7527a9",
      "statement": "Prod compose services are enumerated by the gates from the seven `infrastructure-as-code/docker/*/compose.prod.yaml` files, and the restart-policy gate counts every service in them (27 at the time of writing) as requiring `always` unless it matches the one-shot exemption.",
