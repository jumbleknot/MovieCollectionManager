  "claims": [
    {
      "id": "claim_2123b3ce75ce47ebb5c30c3772814284",
      "statement": "Mobile E2E is split by flow type: flows that drive the assistant dock to POST /bff-api/agent/run must run in CI in the app-e2e job of .forgejo/workflows/app-ci.yml, because the local Windows path runs them against the Metro dev server, which OOM-crashes after a handful of agent /run calls and then presents as a black screen or status 0 networking error; non-agent flows (login, CRUD, sort, browse) run on the local emulator.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/app-ci.yml#L1180-L1278",
          "version": "repo-lines-v1:sha256:4e7887ee64aba559343ff30dec620e9b69e3d9a0c84919fe0a67506c7f2929e0:"
        },
        {
