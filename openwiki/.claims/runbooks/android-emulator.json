          "version": "repo-lines-v1:sha256:dc4e0a232e27f66291e2b4345d95804eb5cbaff437df083b0c8a813d172f6e60:"
        }
      ]
    },
    {
      "id": "claim_98d002d182b849c081b043a7d3ab480a",
      "statement": "The app-e2e mobile half is Metro-less: it builds a standalone release APK (APK_VARIANT=release, APK_ABI=x86_64) with the JS bundle embedded and EXPO_PUBLIC_BFF_NATIVE_URL=http://localhost:8082 plus EXPO_PUBLIC_KEYCLOAK_NATIVE_URL=http://localhost:8099 inlined, so the app talks to the containerized dev BFF and gateway rather than to Metro.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/app-ci.yml#L1191-L1218",
          "version": "repo-lines-v1:sha256:18f5c251c3f8fd46f906c0638c5ed6e0368893a82220a33083587b35b1156ca8:"
        },
        {
          "resource": "repo://frontend/mcm-app/scripts/build-apk.mjs#L70-L92",
          "version": "repo-lines-v1:sha256:5aeec6e5ef85d37a25fb0cd6e7917753d969f094beb2cc7cb34f724016cca472:"
        }
      ]
    },
    {
      "id": "claim_1e3260c77bd241e5abe0b3427b5b77b4",
      "statement": "The release APK build is self-guarded two ways: the CI step asserts that the string localhost:8082 appears inside assets/index.android.bundle (a string that is not a source literal, so its presence proves the EXPO_PUBLIC_* env was re-inlined in this build), and the build disables the Gradle daemon because a reused daemon keeps the environment it started with and would bake a stale backend URL.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/app-ci.yml#L1196-L1218",
          "version": "repo-lines-v1:sha256:3e96b5f320f53bcc5e6f1ae11ff0f88e6a3b9f423e1bbbbb89de8419a7077ce3:"
        },
        {
          "resource": "repo://frontend/mcm-app/scripts/build-apk.mjs#L34-L59",
          "version": "repo-lines-v1:sha256:f4c8b797251de5be361eb8180b1b4853f300259006fe7f6fe45aca9489d05eb4:"
        }
      ]
    },
    {
      "id": "claim_e2700c91527a4e9faf763a297b06c122",
      "statement": "The CI emulator runs an API-34 google_apis_playstore x86_64 image rather than an AOSP one, because the Play Store image ships Chrome, whose Custom Tabs service hands Keycloak's mcm-app:// custom-scheme redirect to the OS; the AOSP WebView shell drops that redirect so native-auth-callback never mounts and login never completes.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/app-ci.yml#L1250-L1268",
          "version": "repo-lines-v1:sha256:ed4d87120819be2a93c0d7d9c792f8a1f68f56499766430aa713e4a5d5ab0b27:"
        }
      ]
    },
    {
      "id": "claim_a16b7d049bfe4814a74f6db525388817",
      "statement": "scripts/ci-mobile-agent-flows.sh defines the agent E2E order (assistant-config-gating, assistant-config-enable-anthropic, the agent flows, assistant-config-disable), runs each flow per-file with up to three attempts to absorb flaky Chrome Custom Tab crashes, and lastly runs the non-agent admin-settings-access flow after adb shell pm clear com.android.chrome plus a re-skip of Chrome's first-run experience so it authenticates as the seeded admin rather than the agent flows' user.",
      "evidence": [
        {
          "resource": "repo://scripts/ci-mobile-agent-flows.sh#L146-L191",
          "version": "repo-lines-v1:sha256:a3a85789217634aa96d96fc5a183de350494ebd814790909ed8bf889f6e20204:"
