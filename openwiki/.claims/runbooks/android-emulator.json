          "version": "repo-lines-v1:sha256:f4c8b797251de5be361eb8180b1b4853f300259006fe7f6fe45aca9489d05eb4:"
        }
      ]
    },
    {
      "id": "claim_b171d5a36c6549f78aacb662b587e145",
      "statement": "The production APK is published by cd-deploy's prod-apk job to the forge's generic package registry as package mcm-app-android, version <expo.version>-<sha7>, with a sha256sum-format sidecar, because this forge exposes no Actions-artifact API (the endpoint is a missing route, not an empty result). publish-apk.mjs prunes at publish time to the newest five versions by created_at and never prunes a version ending in -keep, and it always exits 0 so a registry hiccup cannot fail the non-blocking job.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/cd-deploy.yml#L497-L521",
          "version": "repo-lines-v1:sha256:72fc31bc11da6ef458060d08cbec7f9c7f5e1f01b02d660802dd861da2b2996e:"
        },
        {
