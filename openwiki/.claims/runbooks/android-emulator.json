        },
        {
          "resource": "repo://scripts/devcontainer-android.sh#L1-L65",
          "version": "repo-lines-v1:sha256:c84961986ec8aa794699eade1025be571071232c468e245c50d072303064a846:"
        }
      ]
    },
    {
      "id": "claim_e26e375207014c25bc0cdd1a22b95e32",
      "statement": "scripts/devcontainer-android.sh is the dev-container emulator lifecycle: its default prepare subcommand grants /dev/kvm access and creates the AVD idempotently from postStartCommand, boot starts the AVD headless with KVM and waits for boot_completed (adb-reversing the dev BFF on 8082 and Keycloak on 8099), and on a host with no /dev/kvm it refuses legibly naming both remaining routes rather than failing as if broken.",
      "evidence": [
        {
          "resource": "repo://scripts/devcontainer-android.sh#L12-L33",
          "version": "repo-lines-v1:sha256:a013c8f2d5abb7812b98c43af7b229d7c334e6360b13320f259e9d41fc02874a:"
        },
        {
