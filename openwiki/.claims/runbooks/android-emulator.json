    {
      "id": "claim_9d953c1861874823aaf53425c0a89cb4",
      "statement": "Inlined EXPO_PUBLIC_* values are not part of Metro's transform-cache key, so changing the BFF or Keycloak native URL requires restarting Metro with --reset-cache; build-apk.mjs additionally wipes the temp Metro/metro-file-map cache directories for release builds, and the way to verify is to grep the bundle Metro actually serves.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/android-emulator.md#L171-L180",
          "version": "repo-lines-v1:sha256:b5f6d4c13597027d48e3af619480f171ad0dc90a8247bdf63306fafb91adcdab:"
        },
        {
