    {
      "id": "claim_b0f55e31298d471ab4512ede1fad3006",
      "statement": "The node_modules symlink in a worktree was previously committable because .gitignore carried node_modules/ with a trailing slash (matching only directories, not symlinks); this caused every install-bearing CI job to fail with ENOTDIR. Fixed by changing the pattern to node_modules (no trailing slash).",
      "evidence": [
