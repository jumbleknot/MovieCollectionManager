  "claims": [
    {
      "id": "claim_38bde766ef97415d9b05311aeb02e233",
      "statement": "The Docker Desktop / Docker-in-Docker devcontainer path is retained solely for Android emulator support via /dev/kvm; all other work (web E2E, integration, agent stack, day-to-day assistant) runs on the Docker Sandbox microVM primary environment.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/devcontainer.md#L9-L14",
          "version": "repo-lines-v1:sha256:edc97bc2dde4b009ac4d0884c9aa5295b136a5b42e35f98b408ebaec18e514eb:"
        }
      ]
    },
    {
      "id": "claim_8f39a39dc2d04440871e3ec7fb5aef08",
      "statement": "The devcontainer provides two distinct isolation strengths: strong host-filesystem/credential/SSH isolation (no host profile, SSH keys, credential store, or Docker socket mounted) and only moderate container-engine isolation because DinD requires the container to run privileged, accepting a potential escape path to the shared Docker Desktop WSL2 host engine.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/devcontainer.md#L73-L95",
          "version": "repo-lines-v1:sha256:c383bb5b69613d34a294d58b7c1f63b9bcb3a2f3d1cb405795b8cfb18e64ddf9:"
        }
      ]
    },
    {
      "id": "claim_4c869666a5e745988fd7a4648d1e9794",
      "statement": "init-firewall.sh enforces a default-deny outbound egress policy with a narrow allowlist (Anthropic API, GitHub, npm, container-image registries and their CDN blob hosts) using ipset/iptables; the FORWARD chain is left to dockerd so nested-container networking is not broken, meaning nested containers' egress is not independently firewalled.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/devcontainer.md#L560-L565",
          "version": "repo-lines-v1:sha256:af2834095087266b5fce7755a2ba83a628cba74a525d29b1dd6e36cc1b704cb0:"
        },
        {
          "resource": "repo://docs/runbooks/devcontainer.md#L86-L94",
          "version": "repo-lines-v1:sha256:d400aa313684c506951a4e43bc287c0bd6fe8870c077a6223c8ce6247c629c59:"
        }
      ]
    },
    {
      "id": "claim_918102bfb7a04b93952f4e9581952abf",
      "statement": "Docker Desktop Enhanced Container Isolation (ECI) must remain OFF; ECI is incompatible with the docker-in-docker devcontainer feature and causes a 'mount: /sys/kernel/security: permission denied' failure.",
