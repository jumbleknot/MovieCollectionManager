    {
      "id": "claim_0b0c1d00ef1e42ef8b16af5e68e7e782",
      "statement": "ANTHROPIC_API_KEY must never be set directly on the host or in the devcontainer shell; Claude Code silently prefers it over a subscription login. The key is carried as MCM_ANTHROPIC_API_KEY and remapped to ANTHROPIC_API_KEY only at the point of use (agent gateway, OpenWiki maintenance, containerized E2E recipe) — each a separate process running no interactive assistant. Measured 2026-08-16: ~$15 unintended API spend in one day.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/devcontainer.md#L141-L186",
          "version": "repo-lines-v1:sha256:717df3d00326eb4012ac134c28804df0a450d08236fb317da38ec7683c43ce20:"
