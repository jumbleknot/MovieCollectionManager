    {
      "id": "claim_800455cc6cfb4f8da4d34eb5a8f975f2",
      "statement": "api.themoviedb.org is allowlisted in init-firewall.sh for the devcontainer shell's OUTPUT chain (needed by the pytest integration test runner) but runtime app paths (BFF validate-on-save probe, web-api-mcp curator enrichment) run as nested containers traversing the FORWARD chain and never needed the allowlist entry. Conflating the two chains is the documented trap; a stale ruleset causing timeouts should be fixed by re-applying init-firewall.sh, not by widening the allowlist.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/devcontainer.md#L187-L216",
          "version": "repo-lines-v1:sha256:2f086df9dca3758bf1a644747775c2314657421a61ff46a205c244b7a4dbf61f:"
        }
      ]
    },
    {
      "id": "claim_c4f33eafb73e49a6a453aa3e3fe7af9d",
      "statement": "crates.io is not allowlisted in the devcontainer egress firewall; all cargo commands must use --offline. A failing --offline resolve signals that the change adds a package absent from Cargo.lock — treat it as a lock-discipline check, not an obstacle to work around.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/devcontainer.md#L532-L561",
          "version": "repo-lines-v1:sha256:f08443a077ec407d43b3d758bf044637b8a21a9b43095feff258ba7767a50f59:"
