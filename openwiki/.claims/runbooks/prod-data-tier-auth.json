    {
      "id": "claim_1ec8d118ca90433ba851e81eeb096276",
      "statement": "mongod 9.0.4 refuses to start on Linux kernels 6.19.0 through 7.0.13 (SERVER-121912) with no startup parameter to override it and crash-loops instead, and the CI and prod daemons share one physical host — so the pre-flight kernel gate blocks the merge (`KERNEL-BLOCKED` means stop, do not merge). On Ubuntu the check is not `uname -r`: when `uname -v` contains `Ubuntu`, mongod takes the upstream version from the last field of `/proc/version_signature`.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/prod-data-tier-auth.md#L255-L283",
          "version": "repo-lines-v1:sha256:4bc4c3131234f80241ac5ad5a9f762e0a9030cb788185c385fa8737631a4bf3e:"
