    {
      "id": "claim_a535fd5b62bc493bb0dba1e3e227e860",
      "statement": "Consolidating onto one ResourceSync webhook replaced per-stack redeploy webhooks, because a webhook attached to only one stack redeploys only that stack while the same CD run promoted new digests into every built-image stack's `.env.deploy` — leaving the others running stale images as silent drift; the single sync webhook reconciles and redeploys every affected stack in `after` order.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/Phase-15-Operator-Checklist.md#L161-L178",
          "version": "repo-lines-v1:sha256:2c2153b188ad5b082c978d082779785384f5f8586047112aab6295bf67493b62:"
