    {
      "id": "claim_64e2a9d5228340c6b1a6783033dbb8c4",
      "statement": "Rollback has no Komodo endpoint: the rollback step git-reverts the digest-promotion commit (restoring the prior `.env.deploy`) and re-fires the signed webhook so Komodo redeploys the last-good digest, then exits non-zero to fail the run for operator attention.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/cd-deploy.yml#L276-L291",
