    {
      "id": "claim_cb871e166f4a40f4bd370199b7dfdc45",
      "statement": "The scan and the verdict are two commands so that one exit code carries one meaning: scripts/infra-image-scan.mjs runs Trivy with --format json and no --exit-code (non-zero therefore means only that the scanner could not run), and scripts/check-infra-image-findings.mjs carries the vulnerability verdict from the normalized report. Both the minio-image builder and cd-deploy's per-image loop run this pair before pushing, so an accepted finding lives in security/infra-images/allowlist.yaml instead of a .trivyignore.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/minio-image.yml#L249-L266",
          "version": "repo-lines-v1:sha256:6ac23e238ac2f985c725cfa0a1d7d27a31d785d7d0c8c431ac6286d0b79429dc:"
