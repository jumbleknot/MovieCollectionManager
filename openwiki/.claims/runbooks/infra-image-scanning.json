  "claims": [
    {
      "id": "claim_56495de49283417ebfad3252513b4706",
      "statement": "Publishing a rebuilt MinIO image (via .forgejo/workflows/minio-image.yml) is distinct from promoting it into the compose stacks: a push that edits infrastructure-as-code/docker/minio/Dockerfile both publishes and runs scripts/promote-minio-digest.mjs to promote (repointing every pinned ref found in the tree and opening/updating one pull request); the weekly schedule trigger only publishes (never promotes, since its digest changes every run due to floating apk installs); and a workflow_dispatch run promotes only if its `promote` input is explicitly ticked (default false).",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/minio-image.yml#L40-L51",
          "version": "repo-lines-v1:sha256:78fe0489aca2f0a9748aac907a0a4b73d08f32036dbb36a43e11440074c277a9:"
        },
        {
          "resource": "repo://docs/runbooks/infra-image-scanning.md#L422-L449",
          "version": "repo-lines-v1:sha256:8df5d0258d39d968588eb35b9229779452dd00e385e3f5c17e2fa330cce42f8f:"
        }
      ]
    },
    {
      "id": "claim_8b42e15ea058443eb35956d818f19361",
      "statement": "scripts/promote-minio-digest.mjs must resolve the published image's digest by querying the registry directly for the manifest list (GET /v2/<ns>/minio/manifests/<tag> with index media types preferred) rather than via `docker buildx imagetools inspect`, because imagetools is a client-side operation that talks to the registry itself and ignores the Docker daemon's insecure-registries configuration, causing it to fail over plain HTTP even though `docker push` succeeds in the same job via the daemon.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/infra-image-scanning.md#L468-L492",
          "version": "repo-lines-v1:sha256:c3fb4cdc0cce7c1aeab89584cbe6006cd6cbda18f3aae2f5676963a50ab414ee:"
        },
        {
