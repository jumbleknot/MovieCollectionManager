    {
      "id": "claim_8dd5e75d7e224c469e4e9fa99700e2ed",
      "statement": "scanImage() invokes Trivy through the shared bounded-retry driver in scripts/lib/scanner-retry.mjs (three attempts, exponential 2s/4s backoff), preserving fail-closed behaviour and retrying only a narrowly-classified transport/service failure; the classifier is handed STDERR only, because Trivy writes the vulnerability report to stdout and classifying stdout would let an advisory title decide whether a scan is retried, and the captured stderr in the failure message is the TAIL (readTail) rather than the head.",
      "evidence": [
        {
          "resource": "repo://scripts/infra-image-scan.mjs#L211-L269",
          "version": "repo-lines-v1:sha256:779131ab486e6a40b391c55c4d77a9d2e749641be38e34da79c0446df584905d:"
