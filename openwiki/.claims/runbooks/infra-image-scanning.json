    {
      "id": "claim_56995b2854874dfa9d848ace130e35bd",
      "statement": "A `image:` ref whose registry host is the interpolated `${REGISTRY_HOST}` (the only way a committed file may name an image this project publishes, because check-topology-scrub forbids the forge host) is resolved and enumerated when the variable is set, and when it is unset on a real scan the orchestrator EXITS 2 rather than skipping quietly — a sweep that silently covers fewer images and still passes is worse than one that fails loudly.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/infra-image-scan.yml#L152-L163",
