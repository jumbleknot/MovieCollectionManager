    {
      "id": "claim_5c9c7c1bba5f42b980030d6159df54ce",
      "statement": "The infra-image gate blocks only a FIXABLE Critical: normalizeTrivy marks `blocking = severity === 'Critical' && a FixedVersion exists`, matching the sibling cd-deploy Trivy gate's `--severity CRITICAL --ignore-unfixed`; unfixable Criticals and all fixable High/Medium/Low findings are report-only warnings, and the gate consumes the report's `blocking` flag rather than re-deriving the criterion.",
      "evidence": [
        {
          "resource": "repo://scripts/__tests__/infra-image-scan.test.mjs#L210-L235",
