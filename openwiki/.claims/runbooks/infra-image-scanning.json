          "version": "repo-lines-v1:sha256:4d95408b945dbfc6df2d569620bc2529030fcdced0d6fe44bfc1948f91940a1b:"
        }
      ]
    },
    {
      "id": "claim_f95c3105aabe4acb989556ed6cf676fc",
      "statement": "scripts/promote-minio-digest.mjs computes the count of compose refs to repoint via a live tree scan (findRefs()), which throws on an empty result rather than silently succeeding, instead of trusting a fixed count recorded in a spec/task note — a later feature can add more pinned refs than a stale note remembers.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/infra-image-scanning.md#L493-L497",
