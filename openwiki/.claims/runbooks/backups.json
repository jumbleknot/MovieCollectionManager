    {
      "id": "claim_f011c84757a04d38b03c08753012b118",
      "statement": "The BFF's MongoDB is a standalone mongod with no replica set and no multi-document transactions, so exactly-once job scheduling rests on a single-document atomic claim (findOneAndUpdate) rather than a transaction; the Redis leader lock beside it is an optimization with a TTL guess, not the correctness guarantee.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/backups.md#L29-L31",
          "version": "repo-lines-v1:sha256:ba1a087011c0dc90dc1cebbd84d69ee13e3cc6a866f1894fecbb7c3ae430e52e:"
