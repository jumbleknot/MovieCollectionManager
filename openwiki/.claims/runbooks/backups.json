      "id": "claim_5b86a47d89ae4efd9e3852642427292a",
      "statement": "Feature 073 provides per-user scheduled and on-demand backups of movie collections to user-owned S3-compatible or WebDAV storage, with versioning, keep-last-N retention, and restore that only ever creates a new collection.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/backups.md#L1-L8",
          "version": "repo-lines-v1:sha256:4a24fc32dd5819601b81dacc3200cab7e8ea11b3a8eb9ad95106e2cde1867d0c:"
