        }
      ]
    },
    {
      "id": "claim_992aa7a0f8f64dc380ca065c6f2b97c3",
      "statement": "Destination credentials (S3 secret key, WebDAV app password) are sealed and never returned/logged/echoed; a destination probe failure can only report which kind of failure occurred, never the server's actual reply, and account deletion does not delete the user's stored backup artifacts because they belong to the user's own storage.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/backups.md#L17-L22",
          "version": "repo-lines-v1:sha256:e6ff5bc8632bf51f5c696af607cb273187a6a2283a951cd1e4c3d980423f9af4:"
        }
      ]
    },
    {
      "id": "claim_6aa92f48d28d45eb9e02ce05af635ea8",
      "statement": "An unattended scheduled backup run acts as the user via a Keycloak offline token granted through explicit consent; there is no service account or privileged fallback, so a revoked or missing grant makes the run fail rather than use another identity.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/backups.md#L24-L27",
