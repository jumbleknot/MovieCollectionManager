    {
      "id": "claim_d683557c3dd7445cb0ec8a8394d9b417",
      "statement": "BACKUP_MAX_MOVIES and BACKUP_MAX_UNCOMPRESSED_BYTES exist because a backup run holds the entire artifact in memory instead of streaming it; streaming snapshots are a deliberate filed follow-up, not an oversight.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/backups.md#L44-L57",
          "version": "repo-lines-v1:sha256:fd88afae7bbe8a2197b334b478b1c75ad570d588bdf2165db50962365496d85a:"
