    {
      "id": "claim_e206ef6734ad443d8d5e1c2e0e35bf9f",
      "statement": "The scheduler tick is server.js POSTing to the internal /bff-api/backups/tick route over loopback (127.0.0.1) with a shared secret, because server.js is CommonJS outside the Metro bundle and cannot import src/bff-server/* directly; consequently no tick fires under `pnpm start` in dev and the tick route must be called directly.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/backups.md#L63-L69",
