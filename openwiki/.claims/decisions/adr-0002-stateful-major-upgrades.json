    {
      "id": "claim_8b6898d0a9ad4212967a781a765e86c2",
      "statement": "ADR-0002 ratifies upgrading OpenSearch 2→3 before Langfuse 3→4, each as its own separate spec and pull request, and frames both as security decisions with a clock rather than currency updates: the four allowlisted images have no upstream remediation short of a major, three entries carry expiry 2026-10-01, and the 14-day warning tier opens 2026-09-17.",
      "evidence": [
        {
          "resource": "repo://docs/decisions/ADR-0002-stateful-major-upgrades.md#L14-L47",
          "version": "repo-lines-v1:sha256:828341efaef539ec045cbac26f99356c4003203b66f8bbd7e0d94e04c36e9b53:"
