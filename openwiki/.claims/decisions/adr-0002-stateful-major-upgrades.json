    {
      "id": "claim_018a820ab44a4f58ad3b81e3a6a5e9ee",
      "statement": "OpenSearch is sequenced first because it is the only one of the two majors that discharges a seed-baseline suppression (CVE-2025-14813 in bcprov-jdk15to18, carried since feature 035), while Langfuse 4 has the wider blast radius — it sits on Postgres, ClickHouse, Redis and MinIO and may drag the ClickHouse pin with it — so the narrower migration first keeps a red CI signal attributable to one cause.",
      "evidence": [
        {
          "resource": "repo://docs/decisions/ADR-0002-stateful-major-upgrades.md#L22-L25",
          "version": "repo-lines-v1:sha256:ebec2e6296084b877cfe834078dc6918262c4435c78b57799ab67c3b16bab23c:"
