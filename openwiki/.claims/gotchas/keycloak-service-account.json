    },
    {
      "id": "claim_812dc9ff9e8c4f8da724f9ae8c8c2b93",
      "statement": "Every Admin API function in `keycloak.ts` — `deleteUser`, `countUsersInClientRole`, `logoutUserSessions`, `createUser`, `assignMcUserRole`, `sendVerificationEmail`, `getUserIdByEmail`, `getUserById`, and `ensureClientRedirectUris` — calls `getAdminToken()` itself per operation and sends the resulting token as an `Authorization: Bearer` header against `keycloakAdminApiBase`; the token is never cached, unlike the OIDC discovery document.",
      "evidence": [
        {
          "resource": "repo://frontend/mcm-app/src/bff-server/keycloak.ts#L189-L243",
          "version": "repo-lines-v1:sha256:a950aca8ada3cfe3f0ea7c6134010035a8811de044d1f02259d24594b181ee44:"
