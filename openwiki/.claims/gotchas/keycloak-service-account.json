        }
      ]
    },
    {
      "id": "claim_92c3f8e9170c403c85b4f1e05b5b5987",
      "statement": "The keycloakAdminApiBase used by every Admin API path is derived in env.ts from the internal keycloakUrl (runtime), not from the build-inlined browser-facing keycloakConfig, so Admin API calls reach Keycloak from inside a container over the internal service address.",
      "evidence": [
