    {
      "id": "claim_2b1f52abc0894a3d872df9887ccfc509",
      "statement": "CopilotKit's React Native runtime issues its /bff-api/agent/run request through its own XMLHttpRequest-based streaming-fetch polyfill, which never passes through the axios token-refresh interceptor, so an expired short-lived `mcm_access_token` cookie 401s the run with no refresh attempted; the cookie rides along only because React Native's XMLHttpRequest defaults `withCredentials` to true — the polyfill does not set init.credentials, so a future RN or CopilotKit upgrade that changes that default breaks cookie delivery silently, with the Android E2E harness as the intended regression net.",
      "evidence": [
        {
          "resource": "repo://frontend/mcm-app/src/utils/agent-fetch-refresh.ts#L1-L24",
          "version": "repo-lines-v1:sha256:5e1455aeef81e57035b60e915203c7f9fda2df721b60c430eb157600a8f5b34e:"
        },
        {
          "resource": "repo://frontend/mcm-app/src/utils/token-refresh.ts#L1-L16",
          "version": "repo-lines-v1:sha256:783b8d47bfb8b3488f90b59a3e0ab569448d18c54b492c620379891df0e6c47e:"
        }
      ]
    },
    {
      "id": "claim_4273a20a004c429288eac820fb80747f",
      "statement": "src/utils/agent-fetch-refresh.ts wraps `globalThis.fetch` once (idempotently, no-op where fetch is unavailable) so that a 401 on the agent run route triggers silentRefresh() followed by a single retry with the fresh cookie; the wrapper is installed by the assistant polyfill loader — the first import in app/_layout.tsx — before CopilotKit issues any run, and CopilotKit resolves fetch at call time.",
      "evidence": [
        {
          "resource": "repo://frontend/mcm-app/src/app/_layout.tsx#L6-L9",
          "version": "repo-lines-v1:sha256:332d56df92902cdfbb2e97b8f98ddc802f68e04e452551c80e155dc14b8205ae:"
        },
        {
