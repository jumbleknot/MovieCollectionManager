          "version": "repo-lines-v1:sha256:6e0814fa8ed4a84a161a3e74c6bc8a6a6b7e4b89da397e270d16c7cef6a5bbc5:"
        }
      ]
    },
    {
      "id": "claim_a869a48ca6fc45ad9cb3a503d89bbf43",
      "statement": "serve-static 2 (express 5) changed the `dotfiles` default to ignore files INSIDE a dot-directory as well, which would silently 404 the 45 dependency-shipped assets `expo export` writes under `dist/client/assets/node_modules/.pnpm/…` — the Outfit brand fonts and expo-router's icons — so express 4's rule (ignore only a path whose last segment is a dotfile) is deliberately reproduced by the two-instance selection.",
      "evidence": [
        {
          "resource": "repo://frontend/mcm-app/server.js#L73-L88",
          "version": "repo-lines-v1:sha256:8a654259a8bf7a083dbca982455763e00896698646e77f18c5a471f8df3c24dc:"
