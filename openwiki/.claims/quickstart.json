    {
      "id": "claim_7685d28812604ecf9090353cc31a7fcf",
      "statement": "A bundle page's `resource` front-matter field classifies it: with a resolving resource the page is a derived summary of that file, and with none it is authoritative — canonical in its own right and listed under `authoritative:` in openwiki/protected.yaml. The governance gate (rule G11) rejects a page that is both or neither, so a page cannot be canonical and a summary of something else at once.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/wiki-maintenance.md",
          "version": "repo-file-v1:sha256:eefbce98c8da9e2e807861e00b6ec894d2e313f6a5af125ff5de8b21a00a652e"
