    {
      "id": "claim_0b46ba6c1ba2455cace5c254734776e2",
      "statement": "Reviewing the bundle costs nothing and spending is a separate, explicitly paid step: the `wiki-plan` target runs the planner in `--plan` mode and the `wiki-maintain` target runs `--execute`. The plan is offline, keyless and makes no model call, while `wiki-maintain` is marked PAID because each slice invokes the generator — so a plan is always read before paying.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/project.json#L204-L221",
          "version": "repo-lines-v1:sha256:33edd4b1a62456bf4814b492eefa689619843c460d21009610b7a2aafa661695:"
        }
      ]
    },
    {
      "id": "claim_5e4f5f5fffa64bc4ba5b046ac2b10dde",
      "statement": "A page's `resource` must name one canonical file, never a directory: drift is judged by the cited source's last commit, so a directory citation is re-flagged by every unrelated change beneath it, and the planner reports such a page as *unplannable* rather than paying to regenerate it.",
      "evidence": [
