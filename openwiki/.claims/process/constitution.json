    {
      "id": "claim_ef167eb414894bbd9deaf1cf01038fb6",
      "statement": "The Identity Provider boundary is a hard trust line: a validated, signed JWT is treated as proof the IdP already evaluated and satisfied Conditional Access and MFA, so the application must never re-implement MFA, CA checks or raw credential verification, and its authentication responsibility is limited to cryptographic token validation (signature and `iss`/`aud`/`azp`/`exp`/`nbf` claims), with authorization remaining the application's own responsibility.",
      "evidence": [
        {
          "resource": "repo://.specify/memory/constitution.md#L59-L69",
          "version": "repo-lines-v1:sha256:f700f142b7b21dab32ef88b8ddffdf7e646746aa7ba965e02829175065c05bf7:"
        }
      ]
    },
    {
      "id": "claim_e03b208c28cb4695b3a1181e188c4d29",
      "statement": "The Behavior-Descriptive Identifiers principle bans requirement/specification IDs (e.g. `FR-###`, `SC-###`, `T-###`, `US#`) from code identifiers such as files, modules and exported symbols; the IDs belong in a traceability comment on the artifact, which is the one explicit exception to the prohibition on WHAT-comments.",
      "evidence": [
