  "claims": [
    {
      "id": "claim_48336ae10f46486caf689e37d3d26063",
      "statement": "The OpenWiki bundle is generated through the `wiki-update` Nx target on the infrastructure-as-code project, whose command is `node scripts/wiki-generate.mjs`; the launcher resolves the provider, maps only the selected provider's credential at the point of use, and spawns `openwiki code --update --print`, while `wiki-plan`, `wiki-maintain`, `okf-lint` and `okf-governance` are the four sibling targets around it.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/project.json#L188-L243",
          "version": "repo-lines-v1:sha256:42c12caa5eeb7d3fc9b845809e2fdfa06c7db44a513b78c078e4612f57dae36a:"
        },
        {
          "resource": "repo://scripts/wiki-generate.mjs#L1-L58",
          "version": "repo-lines-v1:sha256:1abb3519929ffa2ba4b6fae22400cd87464cc7be8facb3b02a29caf0fc30855c:"
        }
      ]
    },
    {
      "id": "claim_7c10e5f379364e389cbccbb52bf30315",
      "statement": "`scripts/wiki-generate.mjs` refuses to start unless `OPENWIKI_MAX_OUTPUT_TOKENS` is set to an integer of at least 16384, so a direct invocation cannot bypass the cap; a truncated turn closes the model loop's stop condition and produces a silent exit-0 zero-page run.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/project.json#L194-L201",
          "version": "repo-lines-v1:sha256:0248b593bfbd431aed4933d0adfc64697c77f85de6ae05524772e9b809a6306a:"
