        }
      ]
    },
    {
      "id": "claim_a02c77f9a7104c2f9cad16eb432a456a",
      "statement": "The wiki-maintain workflow is merge-triggered on pushes to `main` with a quiet-period debounce implemented as `concurrency` plus `cancel-in-progress` plus an initial sleep, and it is deliberately never a required branch-protection context because it is a paid and occasionally slow job.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/wiki-maintain.yml#L177-L192",
