          "version": "repo-lines-v1:sha256:8f83ea70b40a345144a68a32c5deb05f7477833163f22c44b009ad8721f50afe:"
        }
      ]
    },
    {
      "id": "claim_06081483f95749c1bbae7732edc7c12c",
      "statement": "A run message must be passed in the `WIKI_RUN_MESSAGE` environment variable, never through `nx --args`: Nx appends args to a shell command line unquoted, so the message arrives split into many words and the paid run goes unscoped. The launcher passes it as a single argv element with no shell.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/wiki-maintenance.md#L233-L243",
          "version": "repo-lines-v1:sha256:f8bccf3285907e1aa3509e3385dc13868880d64fcaa4bfa9def051a3c4b1431d:"
