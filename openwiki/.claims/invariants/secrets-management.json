        }
      ]
    },
    {
      "id": "claim_f8c4a70b14dc4ea5a0feb1c183625ff8",
      "statement": "Masked Komodo Variables are the sanctioned production secrets mechanism: each [[stack]] in infrastructure-as-code/komodo/stacks.toml declares env_file_path = \".env.prod\" (gitignored) and an environment block of [[NAME]] tokens that Komodo interpolates at deploy, while committed additional_env_files = [\".env.deploy\"] carry only host-free bare image digests.",
      "evidence": [
        {
          "resource": "repo://docs/decisions/ADR-0001-prod-secrets-management.md#L11-L18",
          "version": "repo-lines-v1:sha256:b6b5758e572ca99305dc06bf4ed1cdc276562da1683dabf3b6ec2ecc0bfe7dcb:"
