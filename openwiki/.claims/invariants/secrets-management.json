        }
      ]
    },
    {
      "id": "claim_16060928031e453fa9923efb0c3ce554",
      "statement": "Adding a ${VAR:?} to a prod compose changes that stack's required inputs, which are declared only in the Komodo stacks.toml environment block; the break is invisible in CI and only surfaces on a real Komodo deploy, which is why scripts/__tests__/komodo-stack-env.guard.test.mjs asserts that every required variable in a prod compose is supplied by its stack's environment block or additional_env_files.",
      "evidence": [
        {
          "resource": "repo://scripts/__tests__/komodo-stack-env.guard.test.mjs#L1-L21",
          "version": "repo-lines-v1:sha256:0bcdf207ae3284a7fa3ceae0bbe46e30657fc8db8e7fb67cb3b8af8d3e658264:"
