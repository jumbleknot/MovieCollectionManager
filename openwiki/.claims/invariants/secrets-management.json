          "version": "repo-lines-v1:sha256:8dc776ba8b1455bd63509dcce5126912ba9ff7a8c506ee97c1495364a315fadd:"
        },
        {
          "resource": "repo://frontend/mcm-app/src/bff-server/agent-config-store.ts#L1-L13",
          "version": "repo-lines-v1:sha256:036876df88dd40e34485cf7dd5f99585b6e1f4fe3143a11fc8e73475eb64b7a2:"
        }
      ]
    },
    {
      "id": "claim_6e194c5c75544310bd73f4decded4221",
      "statement": "Encrypted per-user credential blobs are bound by GCM additional authenticated data of the form ${userId}:${field}, so a store-layer mixup — one user's blob landing in another's document, or a TMDB blob read as a model key — fails authentication loudly instead of decrypting silently.",
      "evidence": [
        {
          "resource": "repo://frontend/mcm-app/src/bff-server/agent-config-crypto.ts#L28-L43",
          "version": "repo-lines-v1:sha256:f8c30031a757f6fd768595dc657928bf7c08c2a9fcbeb000d513b2d5fa441ac8:"
