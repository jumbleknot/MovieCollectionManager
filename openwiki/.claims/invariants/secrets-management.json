    {
      "id": "claim_1f2f641c36a44d6a816a12e0122530a9",
      "statement": "The only Vault consumer is the Agent Gateway's optional fail-open reader resolve_secret(name, env) in agents/movie-assistant/src/secrets.py, which reads the KV v2 secret at secret/movie-assistant only when both VAULT_ADDR and VAULT_TOKEN are set and otherwise falls through to the environment; it never logs a value and never raises on a Vault error.",
      "evidence": [
        {
          "resource": "repo://agents/movie-assistant/src/secrets.py#L28-L68",
          "version": "repo-lines-v1:sha256:7e006387dbf0b76edfd791d53cc583a11e1816e1c370a5953eec39e7984be509:"
