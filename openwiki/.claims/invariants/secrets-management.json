        }
      ]
    },
    {
      "id": "claim_9183d59bfc7f4c6e8b1b7c4c55d569c6",
      "statement": "HashiCorp Vault is deployed in production deliberately dormant (prod-vault: real Vault, uninitialized and sealed on raft storage, no root token in env, healthcheck override so Komodo sees it as healthy) and is not a secret source for any core stack; a dev-mode Vault exists only behind the vault profile for exercising the agent reader.",
      "evidence": [
        {
          "resource": "repo://docs/decisions/ADR-0001-prod-secrets-management.md#L54-L60",
