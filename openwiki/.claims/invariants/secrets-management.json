    {
      "id": "claim_c526104fd34a439fac11733d8f65ed03",
      "statement": "Per-user bring-your-own credentials (model-provider key, TMDB key, Ollama base URL) are stored AES-256-GCM-encrypted in the BFF's own Mongo store as base64 iv||authTag||ciphertext under AGENT_CONFIG_ENC_KEY, decrypted only transiently in the BFF, and never centralized into Komodo or Vault; feature 073's backup destination secrets reuse the same primitives under a separate BACKUP_CREDENTIAL_ENC_KEY so that key's blast radius stays confined.",
      "evidence": [
        {
          "resource": "repo://frontend/mcm-app/src/bff-server/agent-config-crypto.ts#L1-L63",
          "version": "repo-lines-v1:sha256:afc4e668dd80f4b61044526e37eef123db2169def70f88e462666eec65fe7cd7:"
        },
        {
