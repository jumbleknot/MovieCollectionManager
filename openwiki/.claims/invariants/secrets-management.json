  "claims": [
    {
      "id": "claim_6091fb03c58941adb45c089eae5dc3d7",
      "statement": "No clear-text secret may be committed to git; every credential reaches its consumer through an environment variable, a generator-minted gitignored env file, or a per-user encrypted store, and each mechanism is enforced by a CI gate rather than developer discipline alone.",
      "evidence": [
        {
          "resource": "repo://.specify/memory/constitution.md",
          "version": "repo-file-v1:sha256:abcedb5ecc75b322c2160d211beeda3540ac343162aa8ce8c51e7b0702999528"
        },
        {
          "resource": "repo://scripts/check-no-inline-secrets.mjs",
          "version": "repo-file-v1:sha256:57b4b9c6f32a873da0caec9be010045c8ed822cdcf00cdd19d38ddc1783a8fc8"
        },
        {
          "resource": "repo://scripts/secret-scan.mjs",
          "version": "repo-file-v1:sha256:f9f2ea5590f711a877abf881157f9d72978211ca2e46aa5b3a663105de945ca8"
        }
      ]
    },
    {
      "id": "claim_b775dc1482aa4a3cb251f8954af489f1",
      "statement": "Dev credentials are minted, never committed: scripts/gen-dev-secrets.mjs reads each committed infrastructure-as-code/docker/stacks/<stack>.env.example and writes a gitignored <stack>.env for the four stacks (auth, mcm, audit, observability), replacing <generate:KIND> placeholders with freshly minted values of that kind and copying literals verbatim as deterministic fixtures; scripts/gen-dev-env.mjs then projects the realm client secrets out of stacks/auth.env into the BFF and mc-service gitignored env files so the imported dev realm's client secrets and the BFF's client secrets agree by construction.",
      "evidence": [
        {
          "resource": "repo://scripts/gen-dev-env.mjs#L1-L45",
          "version": "repo-lines-v1:sha256:5456cbd3242fe1b77418bec88cdb1face059a64b35ff31d99e6a1bc3e0dfe60c:"
        },
        {
          "resource": "repo://scripts/gen-dev-secrets.mjs#L1-L100",
          "version": "repo-lines-v1:sha256:478fa89a24ed89beb5a6eba133c9974f61f62508f1fdd46bd79e8f60d71ada2b:"
        }
      ]
    },
    {
      "id": "claim_f43721995468422e89050f32165b99de",
      "statement": "Compose files reference every secret as a fail-fast ${VAR:?message} interpolation: an inline literal fails the gate, and a ${VAR:-default} form also fails because an inline default re-introduces a leaked plaintext value.",
      "evidence": [
        {
          "resource": "repo://scripts/check-no-inline-secrets.mjs#L125-L140",
          "version": "repo-lines-v1:sha256:e13a58c11dd533b6b74c3b2db8d828ec438f2f51589d6a87bd61a74f80658a0a:"
