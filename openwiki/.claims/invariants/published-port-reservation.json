    {
      "id": "claim_721bc41dc071480ea53e9476f1a546d4",
      "statement": "The collision gate discovers candidate compose files with two globs — infrastructure-as-code/docker/**/compose*.yaml and infrastructure-as-code/docker/stacks/*.compose.yaml — and classifies each by basename (a basename ending .prod.yaml is prod, everything else discovered is CI/dev), so a compose file whose name does not begin with 'compose' falls outside the scan.",
      "evidence": [
