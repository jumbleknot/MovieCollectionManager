    {
      "id": "claim_b9ab79ced1814d7cb86695a427d9dea4",
      "statement": "The collision gate compares host port NUMBERS only: entries with no deterministic fixed host port are skipped (a bare container port, a ${VAR} host field, an unparseable entry), host_ip is ignored, and numeric host-port ranges are expanded.",
      "evidence": [
