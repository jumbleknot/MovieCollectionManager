    {
      "id": "claim_0d98456b2b854c44931fa10ac2ef9d03",
      "statement": "The collision gate exits 0 when clean or when its selftest passes, 1 on a collision or a broken selftest, and 2 on bad arguments or an unparseable compose file; --selftest plants an overlap on port 19099 and asserts the parser cases so a gate that stopped detecting cannot report green.",
      "evidence": [
        {
          "resource": "repo://scripts/check-prod-ci-port-collision.mjs#L157-L196",
          "version": "repo-lines-v1:sha256:bed4abd332b461ad0bfa074ce109b072dcc18b84b2c26e074fd6366d5db2a852:"
