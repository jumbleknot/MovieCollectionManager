          "version": "repo-lines-v1:sha256:772490cfa21ce332a19dc9178f1dbc5b3377b711e7572a3e92ed4e043eb115e7:"
        }
      ]
    },
    {
      "id": "claim_4db3abcc6a414664b874c4492224bd0a",
      "statement": "CI tears its stacks down on every run — the app-ci app-e2e job's 'Tear down CI stacks (always)' step runs under if: always() — so a leftover CI stack cannot hold a host port indefinitely and starve a prod redeploy the way the original incident did.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/app-ci.yml#L1374-L1399",
          "version": "repo-lines-v1:sha256:79a1a45059b085c594faad02ba4828b6a75072a1793e87483a374bfb79313712:"
        }
      ]
    },
    {
      "id": "claim_25f71a595e43446fa5f5d5e9d74c9c16",
      "statement": "Expo's legacy default dev-server ports 19000/19001/19006 are unused by this project's Expo SDK and the dev container is explicitly told not to forward them, so those numbers are not prod reservations.",
