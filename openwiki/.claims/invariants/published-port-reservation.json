        }
      ]
    },
    {
      "id": "claim_bad6163d94444b068d929f30f15cc94e",
      "statement": "scripts/check-prod-ci-port-collision.mjs classifies a compose file as prod when its basename ends .prod.yaml (under infrastructure-as-code/docker/**) and every other tracked compose file (compose.yaml, compose.ci.yaml, compose.agent-e2e.yaml, stacks/*.compose.yaml) as CI/dev, then fails the scan when a fixed host port appears in both sets.",
      "evidence": [
        {
          "resource": "repo://scripts/check-prod-ci-port-collision.mjs#L102-L127",
          "version": "repo-lines-v1:sha256:6bd7a6688e51eff82c967e028de1f1b303a6b964fa63ccf45ea88989c6a5f13c:"
