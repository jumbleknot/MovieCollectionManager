    {
      "id": "claim_3ed24ae82fea45319e7f0599311cfe4e",
      "statement": "The prod admin/UI publishes bind 0.0.0.0 with a plain HOST:CONTAINER mapping rather than a tailnet-IP-scoped bind, because the rootless daemon starts before tailscaled at boot and a <tailnet-ip>:host:container publish silently fails; tailnet-only exposure is preserved solely by the host's default-deny-inbound firewall posture, which is load-bearing.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/prod-reboot-resilience.md#L94-L94",
          "version": "repo-lines-v1:sha256:7373daa643e774929c7552ffc8be34086a24552156dac62b3caa34bd1c22a12a:"
