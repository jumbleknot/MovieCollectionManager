    {
      "id": "claim_f58db8fbe0c846e98f9cc7c0ed012dd7",
      "statement": "Moving a prod admin/UI published port into the reserved range leaves the public auth surface untouched: the public issuer stays the Cloudflare-tunnel hostname that reaches keycloak-service:8080 internally over edge-network, and KC_HOSTNAME_BACKCHANNEL_DYNAMIC keeps the internal discovery document advertising that public issuer, so no client or backend reconfiguration follows — only the tailnet admin-console URL (KC_HOSTNAME_ADMIN) moves, which is why a stale admin-console bookmark is the user-visible consequence of the move.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/prod-reboot-resilience.md#L96-L96",
          "version": "repo-lines-v1:sha256:9877b3772b966b7e63146d59ab3262a91c49756ebc7307ae46454fcf020bb158:"
