        }
      ]
    },
    {
      "id": "claim_30e860bddf454cb4a8242805bb7bce9c",
      "statement": "The Agent Gateway and its `agent-db` checkpoint store are private-network only and the client never reaches them: only the BFF starts a run (over an AG-UI stream, attaching a run-scoped delegation token as a non-checkpointed value), and the gateway's single shared in-process MCP client re-exchanges that token per identity-bearing tool call, so each `movie-mcp` call carries a downscoped, short-TTL, audience-bound token that mc-service validates exactly like a human request.",
      "evidence": [
