  "claims": [
    {
      "id": "claim_79bfa33926ea4e809a1bfb90080f5a5c",
      "statement": "The mc-service Domain layer (backend/mc-service/src/domain/) is the innermost Clean Architecture layer: plain Rust structs/enums with no MongoDB, Axum, or other outer-layer dependency, exposing two entities (MovieCollection, Movie), the ExternalIdentifier value object, a DomainError enum, and the Specification rule set.",
      "evidence": [
        {
          "resource": "repo://backend/mc-service/src/domain/errors.rs#L1-L31",
          "version": "repo-lines-v1:sha256:e28af44f19b7c58ca692316c6b444c94f7d7724620a43f0f326517f867798fe3:"
        },
        {
