          "version": "repo-lines-v1:sha256:587572cf347d99ec6fee280ef9321c5684f3145185b4239e3f0ddfd288530a89:"
        }
      ]
    },
    {
      "id": "claim_829870b90c2d4677a072d056f547e110",
      "statement": "MovieCollection::new always seeds the ACL with a single AclEntry granting the owner AclRole::Owner, and MovieCollection::authorizes(user_id, required) grants access when any ACL entry for that user has a rank >= the required role under the hierarchy Owner (3) ⊇ Contributor (2) ⊇ Viewer (1).",
      "evidence": [
