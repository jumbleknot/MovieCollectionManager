  "claims": [
    {
      "id": "claim_55a137e8983d44999848085f7192d594",
      "statement": "The agent layer call chain routes identity through two successive RFC 8693 token exchanges: the BFF exchanges the user's session token for a short-TTL, run-scoped delegation token handed to the Agent Gateway as a non-checkpointed value, and the gateway's shared MCP client exchanges that again for a further-downscoped, aud=mc-service, short-TTL token attached only to the individual tool call.",
      "evidence": [
        {
          "resource": "repo://docs/MCM-Architecture.md#L131-L140",
          "version": "repo-lines-v1:sha256:10a8d69decb2fa50d8b2fe39cd9b6dd6fd10ea75ea8e0d84fe7ee02d88c0d615:"
        },
        {
          "resource": "repo://docs/runbooks/agent-layer.md#L1-L10",
          "version": "repo-lines-v1:sha256:2e373a30df8349944d2beec5d43c90cf6d4e564075a4f05efaccb4c600ed1963:"
        }
      ]
    },
    {
      "id": "claim_c30c1adaddef47fa9b007ea7fb739cc0",
      "statement": "The BFF hosts CopilotRuntime plus the AG-UI HttpAgent (from @ag-ui/client) wired to a vendored ExperimentalEmptyAdapter, performing no LLM call or orchestration itself, because the LangGraph runtime already emits AG-UI events natively; using LangGraphHttpAgent instead would 404 because it speaks the LangGraph Platform REST protocol, not AG-UI.",
      "evidence": [
        {
          "resource": "repo://docs/MCM-Architecture.md#L109-L111",
          "version": "repo-lines-v1:sha256:8a8e9ee22b0c1ff5c642d3828cf7b4b39d1c7e8a8f75ca17933ae03d2c037adf:"
        },
        {
