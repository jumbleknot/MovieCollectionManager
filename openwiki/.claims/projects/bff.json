    {
      "id": "claim_3434ae38c73e442aaace115c44507d27",
      "statement": "The BFF maintains its own MongoDB instance, deliberately separate from mc-service's database, storing per-user agent config (feature 018: encrypted provider/TMDB credentials) and, for feature 073, backup destinations, jobs, and run history — all connected lazily via a cached singleton client in mongo-client.ts using BFF-scoped env.mongoUrl/env.mongoDbName.",
      "evidence": [
        {
          "resource": "repo://frontend/mcm-app/src/bff-server/mongo-client.ts#L1-L16",
          "version": "repo-lines-v1:sha256:d3f2d0af9ce30455c6e4a573f5011c01e11d423cce8722a722ebce32c7cb7dbd:"
        },
        {
