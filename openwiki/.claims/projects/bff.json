    {
      "id": "claim_4230241fbdb34b599a9caf838f7f8f11",
      "statement": "The BFF's Mongo store is a standalone mongod, not a replica set, so no multi-document transaction is available anywhere in it; this shapes the backup feature's design so that all correctness (e.g. exactly-once job claiming) must be expressed within a single document rather than across two.",
      "evidence": [
        {
          "resource": "repo://frontend/mcm-app/README.md#L122-L143",
          "version": "repo-lines-v1:sha256:780693e40be237d192a4c2e1d491f97a85ba3298679481eb24dfa443ca5e0f4c:"
        },
