    {
      "id": "claim_10a94bfb2c2a40c191283b6160604a1a",
      "statement": "Scheduled backup runs act as the user via a Keycloak offline token the user explicitly granted via consent; there is no service account or privileged fallback, and if the offline-token grant is revoked or missing, the scheduled run fails rather than substituting another identity.",
      "evidence": [
        {
