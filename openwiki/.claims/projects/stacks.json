    {
      "id": "claim_edf1065fcded4f8da32364138792c5c5",
      "statement": "`scripts/__tests__/doc-env-example-citations.guard.test.mjs` fails when live documentation cites a `.env*.example` that is not actually tracked in git (checked via `git ls-files`, not `existsSync`), because a dangling template pointer reads to a fresh clone as a broken repository.",
      "evidence": [
