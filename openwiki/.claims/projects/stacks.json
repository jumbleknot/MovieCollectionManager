          "version": "repo-lines-v1:sha256:130dfdaf664e9f4429d6ddecfa6f717a063c096fe502ccf1529269750417aae4:"
        }
      ]
    },
    {
      "id": "claim_ccc73a8eb02648d091fbb98a8d742341",
      "statement": "`.gitignore` ignores `*.env`/`*.env.*` wholesale and un-ignores the templates with an explicit carve-out scoped to the stacks directory (`!infrastructure-as-code/docker/stacks/*.env.example`), so other deliberately-ignored templates such as `frontend/mcm-app/.env.example` stay ignored; a parallel carve-out tracks `*.env.prod.example` under the docker component directories.",
      "evidence": [
        {
          "resource": "repo://.gitignore#L12-L20",
          "version": "repo-lines-v1:sha256:87478ba60947384c3c82e4820e80bc65a778ac7d12d3fb613bdd37a0e3c3385b:"
        }
      ]
    },
    {
      "id": "claim_ff9dab7047c7474cbd23c0de03f315b2",
      "statement": "`scripts/check-no-inline-secrets.mjs` fails the build when a tracked compose file holds a literal credential: every secret-shaped key, password-bearing connection URL, and command/healthcheck/entrypoint auth literal must be a pure `${VAR}` / `${VAR:?message}` reference, an inline `${VAR:-default}` also fails because a default re-leaks plaintext, and non-credential keys matching the name pattern (`*_FILE`, `*_USER`, `*ACCESS_KEY_ID`, `*_CLIENT_ID`, `*_AUDIENCE`) are allowlisted. It runs selftest-then-scan in guardrails.yml's `naming` job.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/guardrails.yml#L91-L108",
          "version": "repo-lines-v1:sha256:960775fb1508748e0c33e414d27a2c4096fc401038bc71d402db494e06abb544:"
        },
        {
          "resource": "repo://scripts/check-no-inline-secrets.mjs#L119-L181",
          "version": "repo-lines-v1:sha256:72a2ec3762f76ab526f995a9454d41e6f6c5f6568aed89ec9247dd57218f189c:"
        },
        {
          "resource": "repo://scripts/check-no-inline-secrets.mjs#L23-L51",
          "version": "repo-lines-v1:sha256:870a8e360d4a0906fdf6a89277e608cf57ba97a73ef5a3e97d713747f25b683e:"
        }
      ]
    },
    {
      "id": "claim_7c8fd50103fa4ca28aa0b84fa244cea0",
      "statement": "`scripts/gen-dev-env.mjs` projects the realm client secrets from `stacks/auth.env` into the BFF's gitignored env files (`frontend/mcm-app/.env.docker`, `.env.local`, `.env.e2e.local`, the web-api-mcp TMDB file, and `backend/mc-service/.env.local`) so the imported dev realm's client secrets and the BFF's client secrets agree by construction; it verifies the projected credentials against the running realm before writing anything and exits 2 refusing to write when the realm rejects them.",
      "evidence": [
        {
          "resource": "repo://scripts/gen-dev-env.mjs#L1-L43",
          "version": "repo-lines-v1:sha256:36b233b94f52e3c3e69d69cae2f531eb2f51a6ebc2f79bac3ec3f0fa627fdcd7:"
        },
