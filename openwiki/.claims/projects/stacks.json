          "version": "repo-lines-v1:sha256:39cfa60e3f85987889c8f285dfc18af24e28cc9777f359ad1bbfce646256ae23:"
        }
      ]
    },
    {
      "id": "claim_fa92632273754c80b16e54bf73fea48f",
      "statement": "`gen-dev-secrets.mjs` exits 0 on success, 1 on a missing or malformed template or unwritable output, and 2 on bad arguments (an unknown `--stack` value or an unknown flag).",
      "evidence": [
