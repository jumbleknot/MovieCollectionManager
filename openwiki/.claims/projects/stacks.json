    },
    {
      "id": "claim_5bd3d1d252c7434ca1fd1a7145ba7702",
      "statement": "`scripts/__tests__/gen-dev-secrets.guard.test.mjs` pins the item #552 back-fill contract in an offline, keyless throwaway mini-repo: all four `BACKUP_TEST_*` keys are seeded into an existing mcm.env, no existing value is rotated, the seeded keys are named in the output, an empty placeholder key is minted in place without being duplicated, a blank fixture key is not treated as missing, and no value is printed.",
      "evidence": [
        {
          "resource": "repo://scripts/__tests__/gen-dev-secrets.guard.test.mjs#L1-L144",
          "version": "repo-lines-v1:sha256:eb4777bb7f0ef9fb22f4df096fb08449682b3e16d4cf1eb9a11b7cd64ced92a2:"
