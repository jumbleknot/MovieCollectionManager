    {
      "id": "claim_a2d19b60f22346618cb8312feb397342",
      "statement": "`scripts/check-prod-ci-port-collision.mjs` compares the fixed published host ports of every `infrastructure-as-code/docker/**/compose.prod.yaml` against every other tracked compose file and fails the build on an overlap, because the prod stacks and the CI runner are separate rootless daemons on one host sharing a single host port space; prod admin/UI ports therefore live in the reserved range `19000–19099`, and the gate scans only the compose `ports:` key, not secondary self-referencing URL variables.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/docker/keycloak/compose.prod.yaml#L45-L53",
          "version": "repo-lines-v1:sha256:0e6c3cfc51950e9abe258258e6cf0961e4b42e8b888badc7710511a0e8d6a80e:"
