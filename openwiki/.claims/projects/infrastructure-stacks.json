    {
      "id": "claim_c636f2d4942d4681a8bbcdd0ad0e646a",
      "statement": "Local stack lifecycle is driven through Nx targets declared in `infrastructure-as-code/project.json` (`up-auth`, `up-mcm`, `up-mcm-agents`, `up-audit`, `up-observability`, `up-all`, and the matching `down-*` targets), which wrap the `docker compose -p <stack> ... --env-file <stack>.env` invocation instead of raw `docker compose` by convention; `up-all` runs auth then mcm serially so Keycloak precedes mc-service.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/project.json#L6-L113",
          "version": "repo-lines-v1:sha256:12f015665c61918571bf99434f4157d69dc82c9b77fbdaf30ededed865314611:"
        }
      ]
    },
    {
      "id": "claim_431f591218254c3b8964de7c103b1c45",
      "statement": "Each local stack pins its own gitignored `<stack>.env` as the interpolation source for its included component files via the long `include:` syntax with an `env_file:` key, and the values are minted from committed `<stack>.env.example` templates by `node scripts/gen-dev-secrets.mjs`; every credential in the stacks is a fail-fast `${VAR:?…}` reference with no clear-text value in a tracked compose file.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/docker/stacks/README.md#L1-L14",
          "version": "repo-lines-v1:sha256:788398f04eb78505a9e48a729324e21a035109dfabf4968674f0a5ddee8059f2:"
