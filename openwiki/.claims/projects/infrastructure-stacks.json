  "claims": [
    {
      "id": "claim_e0fc1f6e4a0a43eab21c4f3498ebd6d8",
      "statement": "`infrastructure-as-code/` defines every environment's runtime topology as config in two halves: four independently operable local Docker Compose stacks under `infrastructure-as-code/docker/stacks/*.compose.yaml` (auth, mcm, audit, observability), each its own Compose project and a thin `include:`-only aggregator over that stack's component compose files; and production, defined by the Komodo ResourceSync stacks in `infrastructure-as-code/komodo/stacks.toml`.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/docker/stacks/audit.compose.yaml",
          "version": "repo-file-v1:sha256:7660be9b48d9b98850eda5a9aa9e3be3c11c66c3a45210bb51446f304fe4638c"
