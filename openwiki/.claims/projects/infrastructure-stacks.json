    {
      "id": "claim_a4b296e73ec84bdba1c9cb114778d27d",
      "statement": "Each production `[stack.config]` block names the Komodo Periphery server, a `linked_repo` + `branch`, a `run_directory` and `file_paths` pointing at that component's `compose.prod.yaml`, an `env_file_path = \".env.prod\"` (gitignored) into which Komodo writes the interpolated `environment`, and an `environment` block whose values are masked Variable tokens `[[NAME]]` resolved at deploy time — the committed TOML carries only references, never a host, domain, IP or secret value.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/komodo/stacks.toml#L30-L44",
          "version": "repo-lines-v1:sha256:28452f8ed388ec7bf9bded5d7da30b7eb26c1fd1dba6d439d0bd5388de53fcae:"
