    {
      "id": "claim_7b2886947d0549a18ff7c1b047929d61",
      "statement": "`infrastructure-as-code/komodo/stacks.toml` declares seven `[[stack]]` blocks that a Komodo ResourceSync diff-applies and deploys: the four core application stacks `prod-auth`, `prod-mc-service`, `prod-mcm-bff`, `prod-movie-assistant`, plus the three support stacks `prod-audit`, `prod-observability` and `prod-vault` added with the production Control Tower.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/komodo/stacks.toml#L26-L187",
          "version": "repo-lines-v1:sha256:d959375a0c6bc5dab8caafb176b7a8b9cc6c9e7fd6e2ca4505dda90b3b069053:"
        }
      ]
    },
    {
      "id": "claim_f33eba0eaf9f49d99fd27d7ccb6b5764",
      "statement": "Production deploy order is declared by `after` (`deploy = true` makes the sync deploy as well as apply): `prod-mc-service` depends on `prod-auth` because mc-service fetches Keycloak's JWKS, `prod-mcm-bff` depends on `prod-mc-service`, and `prod-movie-assistant` comes last because `spreadsheet-mcp` needs `prod-mcm-bff`'s `mcm-bff-network` and Redis; the support stacks attach as `prod-vault` after `prod-auth`, `prod-observability` after `prod-mcm-bff` for ordering only, and `prod-audit` as an independent root.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/docker/spreadsheet-mcp/compose.yaml#L4-L8",
          "version": "repo-lines-v1:sha256:5b5873db4732df5a20f1d5d4726735c8bfe3d8ba55f682b9c93de43ef648d0b4:"
