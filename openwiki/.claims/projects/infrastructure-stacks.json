        }
      ]
    },
    {
      "id": "claim_d069cb6ce2e8426d99c1b4cb5dd047a6",
      "statement": "Image digests are not in `stacks.toml`: a tracked, host-free `.env.deploy` beside each component's prod compose carries the bare per-service digest and is passed as `additional_env_files` last, so the digest interpolates from git while `REGISTRY_HOST` and secrets interpolate from `.env.prod`; the compose assembles the pull reference as `${REGISTRY_HOST}/jumbleknot/<svc>@${<SVC>_DIGEST}`. They are written by CI's digest-by-git promotion step, so editing one by hand defeats the promotion mechanism.",
      "evidence": [
        {
          "resource": "repo://.forgejo/workflows/cd-deploy.yml#L240-L248",
          "version": "repo-lines-v1:sha256:2774c4dba6ac884150fab71e2525ebb846d34aba51db7a3fb0bd4bd70694ac8f:"
        },
        {
