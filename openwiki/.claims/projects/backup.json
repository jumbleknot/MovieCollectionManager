          "version": "repo-file-v1:sha256:cbefd7777b9c4b5748cac2f00f4f8b2477de342bdd35dda977588c418f2976c5"
        }
      ]
    },
    {
      "id": "claim_2901e50171bb4165813d064feb5cd162",
      "statement": "The backup is config-as-code: the scripts, systemd units and a checksum manifest live in infrastructure-as-code/backup/, and the host runs copies installed at ~/backup/*.sh and ~/.config/systemd/user/homelab-backup*; that directory's README is the canonical install/update/verify contract.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/backup/README.md",
          "version": "repo-file-v1:sha256:cbefd7777b9c4b5748cac2f00f4f8b2477de342bdd35dda977588c418f2976c5"
