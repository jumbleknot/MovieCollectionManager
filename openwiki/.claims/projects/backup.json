    {
      "id": "claim_2151d3f4cd504d69a7597dc26fc14135",
      "statement": "INSTALLED.sha256 is the artefact that lets an operator with no repository checkout prove the host runs what the repository says: it lists every installable file as <sha256>  <path relative to $HOME> at the path the README's install block puts it, sorted so a regenerated list diffs cleanly. It is regenerated by scripts/backup-install-manifest.mjs --write and verified with --check, and a guard fails when the committed list disagrees with the directory or omits a new installable file — a stale list is worse than none, because the operator's sha256sum -c would then pass against an old script.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/backup/README.md",
          "version": "repo-file-v1:sha256:cbefd7777b9c4b5748cac2f00f4f8b2477de342bdd35dda977588c418f2976c5"
