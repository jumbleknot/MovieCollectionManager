    {
      "id": "claim_f82968160de74a59a896906302f87b6c",
      "statement": "The forge data tar is deliberately uncompressed: restic chunks content-defined and de-duplicates an unchanged file, so a mostly-unchanged tar costs roughly the day's real change, whereas the old forgejo dump --type tar.gz changed from its first changed byte onwards and de-duplicated nothing — 19.8-21.1 GiB added to the repository every night.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/Server-Setup-Runbook.md#L1097-L1097",
          "version": "repo-lines-v1:sha256:f70b5d6d97629511a808d21b036c6e14a0cf9ce50c27c70a712802f7da7b206a:"
        },
        {
