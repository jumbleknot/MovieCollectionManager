  "claims": [
    {
      "id": "claim_fb99a132195d426bb1f78d4948851875",
      "statement": "The prod host backup is the operator's host-level disaster recovery: a restic snapshot of every stateful prod service (Forgejo, Komodo, Keycloak, agent-db and both Mongo instances), the service config directories, and the release APKs a rebuild cannot reproduce, pushed to a remote the operator controls. It is explicitly not the same system as feature 073's per-user collection backups, and neither replaces the other: a user's own backup does not protect the host, and the host snapshot cannot be restored per user.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/Server-Setup-Runbook.md#L1041-L1051",
          "version": "repo-lines-v1:sha256:be3c602482a1ff37a3a3d405115e8388d7d1bbcff7d633b0420a6f35b01e2cfe:"
        },
        {
