    {
      "id": "claim_48653face1404092b0f39625abcc7072",
      "statement": "A dump whose size falls below 50% of the same dump in the last good run raises a shrink alert naming the dump and both sizes, but the snapshot is still uploaded and the run still succeeds. An expected shrink is accepted once with backup.sh --ack-shrink <dump>, which writes a state file the next run consumes and deletes; the threshold is never raised instead, and only a fully good run rewrites the last-good manifest that the comparison is based on.",
      "evidence": [
        {
          "resource": "repo://infrastructure-as-code/backup/README.md",
          "version": "repo-file-v1:sha256:cbefd7777b9c4b5748cac2f00f4f8b2477de342bdd35dda977588c418f2976c5"
        },
