        }
      ]
    },
    {
      "id": "claim_e161225148da4de0a1bdef851114c17d",
      "statement": "Dump staging must be on disk: /tmp on the prod host is a 29 G tmpfs, the Forgejo dump outgrew it, and the original script staged there, so backups failed every night from 2026-07-27 to 2026-10-22 and the outage was found by chance. backup.sh therefore stages under ~/backup/ and refuses a tmpfs staging filesystem before dumping anything, and backup.sh --check-staging reports the filesystem without backing anything up.",
      "evidence": [
        {
          "resource": "repo://docs/runbooks/Server-Setup-Runbook.md",
          "version": "repo-file-v1:sha256:f1cf1e65d23cd8dcc90f81b0493c287e91ff5b74ae0eab042c0a0f8800a8bf50"
