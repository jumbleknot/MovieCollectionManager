# observability stack secrets — feature 021 (externalize-compose-secrets).
#
# This template is COMMITTED. Real values are minted per-machine by
#   node scripts/gen-dev-secrets.mjs
# into observability.env (gitignored). NEVER put a real value in this file.
#
# Randomized credentials (each <generate:KIND> is freshly minted):
LANGFUSE_PG_PASSWORD=<generate:b62-32>
LANGFUSE_CLICKHOUSE_PASSWORD=<generate:b62-32>
LANGFUSE_REDIS_PASSWORD=<generate:b62-32>
LANGFUSE_MINIO_ROOT_PASSWORD=<generate:b62-32>
LANGFUSE_SALT=<generate:b62-48>
LANGFUSE_ENCRYPTION_KEY=<generate:hex-64>
LANGFUSE_NEXTAUTH_SECRET=<generate:b62-48>
LANGFUSE_INIT_USER_PASSWORD=<generate:b62-48>
UNLEASH_PG_PASSWORD=<generate:b62-32>
UNLEASH_ADMIN_TOKEN=<generate:unleash-admin>
UNLEASH_CLIENT_TOKEN=<generate:unleash-client>
# Deterministic fixtures (copied verbatim — the agent gateway + feature-012 SC-008 verify test
# authenticate against these exact values; do NOT randomize them):
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-mcm-dev-0000000000000000
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-mcm-dev-0000000000000000

# Topology-sensitive, and NOT a secret — but deliberately left blank here, because
# check-topology-scrub.mjs forbids a real host in a committed file. Set it per machine.
#
# Needed since feature 069 (item #420): MinIO deleted minio/minio and minio/mc from Docker Hub and
# distributes source only, so this stack now pulls `jumbleknot/minio` — an image this project builds
# from source — from the forge registry instead. Left blank the compose refs fail loudly naming this
# variable, which is the intended behaviour; they do not silently resolve to an invalid ref.
REGISTRY_HOST=
