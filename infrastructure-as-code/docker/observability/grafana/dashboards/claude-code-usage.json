      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 7,
      "title": "Weekly weighted tokens by feature",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dev-usage-store"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dev-usage-store"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT week::timestamptz AS time, COALESCE(feature_id, 'no feature') AS metric, SUM(weighted_tokens) AS value\nFROM usage.v_weekly_trend\nWHERE $__timeFilter(week::timestamptz)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 8,
      "title": "Features and their outcomes",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dev-usage-store"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dev-usage-store"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT feature_id AS feature, kind, spec_dir AS spec, pr_state AS pr, pr_number, sessions, turns,\n       round(weighted_tokens) AS weighted, commits, lines_added, lines_removed,\n       CASE WHEN tasks_total IS NULL THEN 'n/a' ELSE tasks_done || '/' || tasks_total END AS tasks,\n       ci_runs_red, ci_runs_green, backlog_closed, first_seen_at, merged_at\nFROM usage.v_feature_totals\nWHERE $__timeFilter(first_seen_at)\nORDER BY first_seen_at DESC\nLIMIT 100"
        }
      ]
    }
  ]
}
